/dts-v1/;

/ {
	model = "MT6833";
	compatible = "mediatek,MT6833";
	interrupt-parent = <0x1>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	aliases {
		i2c0 = "/i2c@11e00000";
		i2c1 = "/i2c@11d20000";
		i2c2 = "/i2c@11d21000";
		i2c3 = "/i2c@11cb0000";
		i2c4 = "/i2c@11d22000";
		i2c5 = "/i2c@11e01000";
		i2c6 = "/i2c@11f00000";
		i2c7 = "/i2c@11e02000";
		i2c8 = "/i2c@11d00000";
		i2c9 = "/i2c@11d01000";
		ovl0 = "/disp_ovl0@14005000";
		ovl3 = "/disp_ovl0_2l@14006000";
		rdma0 = "/disp_rdma0@14007000";
		wdma0 = "/disp_wdma0@14014000";
		dsi0 = "/dsi@14013000";
		color0 = "/disp_color0@14009000";
		ccorr0 = "/disp_ccorr0@1400b000";
		aal0 = "/disp_aal0@1400c000";
		gamma0 = "/disp_gamma0@1400d000";
		dither0 = "/disp_dither0@1400f000";
		postmask0 = "/disp_postmask0@1400e000";
	};
	chosen {
		bootargs = "console=tty0 root=/dev/ram 			8250.nr_uarts=4 			rcupdate.rcu_expedited=1 			vmalloc=400M swiotlb=noforce 			firmware_class.path=/vendor/firmware 			androidboot.hardware=mt6833 			transparent_hugepage=never 			initcall_debug=1";
		kaslr-seed = <0x0 0x0>;
		phandle = <0x61>;
	};
	clkitg {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0xed>;
