	trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		tee-id = <0x0>;
		tee-name = "trusty";
		phandle = <0x1ca>;
		trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0xea>;
		};
		trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x1>;
			phandle = <0xeb>;
		};
		tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0xea>;
			irq-supply = <0xeb>;
			phandle = <0xec>;
		};
		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0xec>;
			phandle = <0x1cb>;
		};
		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};
	};
	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		tee-id = <0x1>;
		tee-name = "nebula";
		phandle = <0x1cc>;
		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};
		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x1>;
		};
		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};
	hypervisor {
		compatible = "mediatek,geniezone-hyp", "mediatek,geniezone";
		status = "disabled";
		phandle = <0x1cd>;
	};
